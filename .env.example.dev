# Lokale Entwicklung in ddev. Die echte .env erzeugt der pre-start-Hook aus dem
# 1Password-Environment des Projekts (.ddev/env-from-1password.sh); diese Datei
# zeigt, welche Werte es braucht.
# Konfiguration: https://craftcms.com/docs/5.x/configure.html

# The application ID used to uniquely store session and cache data, mutex locks, and more
CRAFT_APP_ID=

# The environment Craft is currently running in (dev, staging, production)
CRAFT_ENVIRONMENT=dev

# The secure key Craft will use for hashing and encrypting data
CRAFT_SECURITY_KEY=

# Database connection settings (ddev-Vorgaben)
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=db
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=db
CRAFT_DB_USER=db
CRAFT_DB_PASSWORD=db
CRAFT_DB_SCHEMA=
CRAFT_DB_TABLE_PREFIX=

# General settings (see config/general.php)
PRIMARY_SITE_URL=https://domain.tld.ddev.site
BASE_URL=https://domain.tld.ddev.site
WEB_ROOT=/web
ASSETS_BASE_URL=https://domain.tld.ddev.site/assets
ASSETS_BASE_PATH=/var/www/html/web/assets

# Mail Einstellungen
MAIL_ADDRESS=""
MAIL_HOST=""
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_PORT=587

# FTP Daten staging (ddev npm run deploy:staging)
FTP_HOST_STAGING=""
FTP_USER_STAGING=""
FTP_PASSWORD_STAGING=""

# FTP Daten production (ddev npm run deploy:production)
FTP_HOST_PRODUCTION=""
FTP_USER_PRODUCTION=""
FTP_PASSWORD_PRODUCTION=""

# Mux
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
# Nur lokal: öffentlicher Tunnel zum Video-Volume, damit Mux die Dateien abrufen kann (config/_muxmate.php)
VIDEOS_BASE_URL=https://xxx.ngrok-free.app/assets/assetsHandle

# PageSpeed (ddev npm run pagespeed -- staging|production)
# Google Cloud → APIs & Services → PageSpeed Insights API → Credentials
PAGESPEED_API_KEY=""
PAGESPEED_URL_STAGING=""
PAGESPEED_URL_PRODUCTION=""
