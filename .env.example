# Read about configuration, here:
# https://craftcms.com/docs/4.x/config/

# The application ID used to to uniquely store session and cache data, mutex locks, and more
CRAFT_APP_ID=

# The environment Craft is currently running in (dev, staging, production, etc.)
CRAFT_ENVIRONMENT=dev

# The secure key Craft will use for hashing and encrypting data
CRAFT_SECURITY_KEY=

# Database connection settings
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=db
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=db
CRAFT_DB_USER=db
CRAFT_DB_PASSWORD=db
CRAFT_DB_SCHEMA=    
CRAFT_DB_TABLE_PREFIX=

# General settings (see config/general.php)
PRIMARY_SITE_URL=https://DOMAIN.TLD.ddev.site
BASE_URL=https://DOMAIN.TLD.ddev.site
WEB_ROOT=/web
ASSETS_BASE_URL=https://DOMAIN.TLD.ddev.site/assets
ASSETS_BASE_PATH=/var/www/html/web/assets

# Mail Einstellungen
MAIL_ADDRESS=""
MAIL_HOST=""
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_PORT=587

# FTP Daten staging
FTP_HOST_STAGING=""
FTP_USER_STAGING=""
FTP_PASSWORD_STAGING=""

# FTP Daten production
FTP_HOST_PRODUCTION=""
FTP_USER_PRODUCTION=""
FTP_PASSWORD_PRODUCTION=""

# Mux
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
VIDEOS_BASE_URL=https://XXX.ngrok-free.app

# PageSpeed (ddev npm run pagespeed -- staging|production)
# Google Cloud → APIs & Services → PageSpeed Insights API → Credentials
PAGESPEED_API_KEY=""
PAGESPEED_URL_STAGING=""
PAGESPEED_URL_PRODUCTION=""
