# Server: staging oder production. FTP- und PageSpeed-Werte gehören nicht
# hierher – sie brauchen nur die lokalen Skripte (siehe .env.example.dev).
# Konfiguration: https://craftcms.com/docs/5.x/configure.html

# The application ID used to uniquely store session and cache data, mutex locks, and more
CRAFT_APP_ID=

# The environment Craft is currently running in: staging oder production
CRAFT_ENVIRONMENT=production

# The secure key Craft will use for hashing and encrypting data – eigener Wert je Server
CRAFT_SECURITY_KEY=

# Database connection settings (Angaben des Hostings)
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER="localhost"
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=""
CRAFT_DB_USER=""
CRAFT_DB_PASSWORD=""
CRAFT_DB_SCHEMA=
CRAFT_DB_TABLE_PREFIX=

# General settings (see config/general.php)
PRIMARY_SITE_URL=https://domain.tld
BASE_URL=https://domain.tld
WEB_ROOT=/web
ASSETS_BASE_URL=https://domain.tld/assets
ASSETS_BASE_PATH=assets

# Mail Einstellungen
MAIL_ADDRESS=""
MAIL_HOST=""
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_PORT=587

# Mux
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
