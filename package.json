{
    "name": "domain.tld",
    "version": "1.0.0",
    "description": "",
    "type": "module",
    "main": "src/App.js",
    "scripts": {
        "copy": "node scripts/copy-files.js build",
        "watch:copy": "node scripts/copy-files.js dev",
        "dev:vite": "vite",
        "dev": "npm-run-all --parallel watch:copy dev:vite",
        "build": "npm run copy && vite build",
        "build:staging": "npm run copy && vite build --mode staging",
        "deploy:staging": "node scripts/deploy.js staging",
        "deploy:production": "node scripts/deploy.js production",
        "release:staging": "npm run build:staging && npm run deploy:staging",
        "release:production": "npm run build && npm run deploy:production",
        "generate-transforms": "node scripts/generate-transforms.js",
        "lint": "eslint .",
        "pagespeed": "node scripts/pagespeed.js"
    },
    "author": "Moritz Profitlich",
    "license": "ISC",
    "devDependencies": {
        "@capsizecss/core": "^4.1.3",
        "@capsizecss/unpack": "^4.0.1",
        "@eslint/js": "^10.0.1",
        "@rollup/rollup-linux-arm64-gnu": "^4.63.6",
        "@spiriit/vite-plugin-svg-spritemap": "^7.2.0",
        "archiver": "^8.0.0",
        "del": "^8.0.1",
        "easing-progress": "^1.0.2",
        "eslint": "^10.11.0",
        "globals": "^17.13.0",
        "npm-run-all": "^4.1.5",
        "postcss-input-range": "^6.0.0",
        "sass": "^1.105.1",
        "svgo": "^4.1.0",
        "terser": "^5.51.2",
        "vite": "^8.3.2",
        "vite-plugin-manifest-sri": "^0.2.0",
        "yaml": "^2.9.1"
    },
    "dependencies": {
        "@mux/mux-player": "^3.13.4",
        "@profitlich/template-toolkit": "^7.5.0",
        "debounce": "^3.0.0",
        "pathe": "^2.0.3"
    }
}
